# ヒイラギの環境変数のひな形。
# このファイルをコピーして .env.local という名前で保存し、値を入れてください。
# .env.local は git に入りません（秘密の値をそのまま書いて大丈夫です）。

# ── 必須 ─────────────────────────────────────────────
# Supabase(Postgres) の接続文字列。Supabase の Project Settings > Database > Connection string
# （Session pooler, port 5432）からコピーします。サーバー側だけで使い、ブラウザには出ません。
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ログイン用Cookieの署名に使う秘密の文字列（32文字以上のランダムな文字列）
# 作り方: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 定期監視の入口（/api/cron/check）を叩くための合言葉。
# GitHub Actions のシークレット CRON_SECRET と同じ値にします。
# 作り方: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# ── 任意 ─────────────────────────────────────────────
# 監視処理が自分自身（デモ用の模擬ショップ）を見に行くときのURL。
# ローカルでは http://localhost:3600、本番では https://<アプリのドメイン>。
# Vercel では未設定でも VERCEL_PROJECT_PRODUCTION_URL から自動で判断します。
APP_BASE_URL=http://localhost:3600

# 1 にすると、アカウント作成に招待コードが必要になります（既定は不要）。
SIGNUP_INVITE_REQUIRED=
